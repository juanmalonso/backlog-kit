{
  "name": "backlog-kit",
  "displayName": "Backlog Kit",
  "description": "Backlog de historias en markdown dentro del repo: tablero kanban, init con scripts, skills de Claude Code, GitHub Issues y protección de main.",
  "version": "0.1.0",
  "publisher": "juanmalonso",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/juanmalonso/backlog-kit" },
  "engines": { "vscode": "^1.90.0", "node": ">=20" },
  "categories": ["Other"],
  "keywords": ["backlog", "kanban", "user stories", "claude code", "markdown"],
  "main": "./dist/extension.js",
  "bin": { "backlog-kit": "./bin/backlog-kit.mjs" },
  "activationEvents": ["workspaceContains:.pm/config.json"],
  "contributes": {
    "commands": [
      { "command": "backlogKit.openBoard", "title": "Abrir tablero / Open board", "category": "Backlog Kit", "icon": "$(project)" },
      { "command": "backlogKit.init", "title": "Inicializar proyecto / Initialize project", "category": "Backlog Kit" },
      { "command": "backlogKit.refresh", "title": "Actualizar tablero / Refresh board", "category": "Backlog Kit" }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3"
  }
}
